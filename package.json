{
  "name": "sir-jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Bootstrap local de Jarvis, asistente personal autogestionado.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <13"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node src/app/main.ts",
    "diagnose": "node src/app/main.ts diagnose",
    "telegram": "node src/app/telegram-main.ts",
    "telegram:start": "node dist/app/telegram-main.js",
    "agents:demo": "node src/app/agent-demo.ts",
    "agents:https:demo": "node tests/run-agent-https-demo.ts",
    "agents:telegram:demo": "node tests/run-telegram-agents-demo.ts",
    "telegram:agents:demo": "node tests/run-telegram-agents-live.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
