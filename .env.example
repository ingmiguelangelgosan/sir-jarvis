# Diagnóstico local sin credenciales; Telegram se inicia explícitamente.
# Opcional: copiar a .env. Las variables del proceso tienen prioridad.
NODE_ENV=development
JARVIS_TIMEZONE=America/Bogota

# Único valor admitido en esta fase. No activa proveedores ni facturación.
JARVIS_AI_MODE=disabled

# Solo para npm run telegram. Token propio de @BotFather; nunca versionar .env.
# No rellenar estos campos para ejecutar diagnóstico, CI o tests.
TELEGRAM_BOT_TOKEN=
# IDs numéricos, separados por comas; se recomienda un propietario por instancia.
TELEGRAM_ALLOWED_USER_IDS=

# Integración opcional de lectura con agentes. Deshabilitada por defecto.
JARVIS_TELEGRAM_AGENTS_ENABLED=false
# Solo al habilitar: configuración privada, nunca un path enviado por Telegram.
# JARVIS_AGENTS_CONFIG_FILE=.local/agents.json
# Clave propia estable de 32–64 bytes en base64url; no reutilizar el Bearer.
# JARVIS_TELEGRAM_AGENT_KEY=
# Bearer propio según credential_variables del archivo local.
# JARVIS_ECHO_BEARER=
# Persistencia opcional: inicializar explícitamente antes con npm run state:init -- <ruta>.
# Con esta variable configurada, DB ausente/corrupta detiene el bot; no hay fallback.
# JARVIS_STATE_FILE=.local/state/jarvis.sqlite

# Alternativa local/contenedor: definir *_FILE y OMITIR la variable directa.
# No combinar, ni siquiera con TELEGRAM_BOT_TOKEN= vacío.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_token
# TELEGRAM_ALLOWED_USER_IDS_FILE=/run/secrets/allowed_users
# JARVIS_TELEGRAM_AGENT_KEY_FILE=/run/secrets/action_key
# JARVIS_ECHO_BEARER_FILE=/run/secrets/echo_bearer
# Directorio privado compartido por todos los consumidores locales del mismo bot.
# JARVIS_RUNTIME_DIRECTORY=.local/runtime
# Heartbeat opcional: archivo nuevo exclusivo, separado de datos y secretos.
# JARVIS_HEALTH_FILE=.local/runtime/jarvis-health
# La clave de backup se pasa por archivo al CLI; no se carga como variable del bot.
