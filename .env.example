# Diagnóstico local sin credenciales; Telegram se inicia explícitamente.
# Opcional: copiar a .env. Las variables del proceso tienen prioridad.
NODE_ENV=development
JARVIS_TIMEZONE=America/Bogota

# Único valor admitido en esta fase. No activa proveedores ni facturación.
JARVIS_AI_MODE=disabled

# Solo para npm run telegram. Token propio de @BotFather; nunca versionar .env.
# No rellenar estos campos para ejecutar diagnóstico, CI o tests.
TELEGRAM_BOT_TOKEN=
# IDs numéricos, separados por comas; se recomienda un propietario por instancia.
TELEGRAM_ALLOWED_USER_IDS=
